# Supabase project for the admin (and later the customer app).
# Both values are public by design; the database enforces access with Row Level Security.
# NEVER put the service_role key here or anywhere in this repository.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push: the VAPID PUBLIC key only (npx web-push generate-vapid-keys). Empty → push is off,
# the in-app notification centre still works. The PRIVATE key goes ONLY into the push-dispatch
# Edge Function secrets (see docs/notifications.md) — never here.
VITE_VAPID_PUBLIC_KEY=
